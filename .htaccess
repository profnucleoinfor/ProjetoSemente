# Bloquear acesso direto a diretórios sensíveis
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Permitir o acesso apenas ao diretório público da aplicação
# Se a estrutura for movida para fora da raiz pública em produção,
# os caminhos abaixo podem ser ajustados para refletir o local real.
